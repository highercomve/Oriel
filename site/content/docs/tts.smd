.title = "Offline text to speech",
.description = "Read text aloud offline with oriel.tts: Kokoro-82M voices, verified downloads, streaming playback on the CPU or GPU.",
.date = .date("2026-10-09T00:00:00"),
.authors = ["Oriel"],
