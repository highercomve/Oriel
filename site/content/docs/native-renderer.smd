  <rect class="nr-box nr-hot" x="20" y="152" width="330" height="96" rx="10"/>
  <text class="nr-t" x="36" y="178">Renderer process (sandboxed)</text>
  <text class="nr-s" x="36" y="200">HTML, CSS, layout, V8, the GPU</text>
  <text class="nr-s" x="36" y="220">compositor: the page itself</text>
  <text class="nr-h" x="410" y="28">With the native renderer</text>
  <rect class="nr-box nr-acc" x="410" y="44" width="330" height="140" rx="10"/>
