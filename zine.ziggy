.zine_version = "0.14.0",
// Local fallback; `scripts/site-version.sh` (called by CI before `zine
// release`) rewrites it with GitHub's latest release, read at build time.
.custom = .{
    .version = "v0.15.1",
    .releases_link = "https://github.com/highercomve/Oriel/releases/tag/v0.15.1",
},
.site = .simple(.{
    .title = "Oriel",
    .host_url = "https://highercomve.github.io",
    .content_dir_path = "site/content",
    .layouts_dir_path = "site/layouts",
    .assets_dir_path = "site/assets",
    .url_path_prefix = "Oriel",
