<row id="row" height="34" padding="0,16,0,16" align="center" border-bottom="1" border-color="#30363d66">
  <view width="90" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#8b949e" shrink="0" id="pid" nowrap="true" mono="true" line-height="18.0">{pid}</text>
  </view>
  <view width="190" padding="0,16,0,0" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#f0f6fc" shrink="0" id="name" mono="true" tooltip="{name}" nowrap="true" line-height="18.0">{name}</text>
  </view>
  <view width="90" padding="0,8,0,0" min-width="0" clip="true" justify="center">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#8b949e" shrink="0" id="user" nowrap="true" line-height="18.0">{user}</text>
  </view>
  <view width="50" min-width="0" clip="true" justify="center">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#6e7681" shrink="0" text-align="center" id="state" nowrap="true" line-height="18.0">{state}</text>
  </view>
  <view width="48" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#8b949e" shrink="0" text-align="right" id="threads" nowrap="true" mono="true" line-height="18.0">{threads}</text>
  </view>
  <view width="90" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#f0f6fc" shrink="0" text-align="right" id="cpu" nowrap="true" mono="true" line-height="18.0">{cpu}</text>
  </view>
  <view width="110" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#8b949e" shrink="0" text-align="right" id="mem" nowrap="true" mono="true" line-height="18.0">{mem}</text>
  </view>
  <view basis="0" grow="1" shrink="1" padding="0,0,0,16" min-width="0" clip="true" justify="center">
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#6e7681" shrink="0" id="command" tooltip="{command}" nowrap="true" mono="true" line-height="16.5">{command}</text>
  </view>
  <row width="140" justify="flex-end" gap="6">
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="actions" tooltip="{kill_tip}" label="{kill_tip}" value="Terminate…" width="84" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" height="18" font-size="10" radius="4" />
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="copy" tooltip="Copy process name" label="Copy process name" value="Copy" width="38" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" height="18" font-size="10" radius="4" />
  </row>
</row>
