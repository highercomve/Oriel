<column position="absolute" top="130" left="180" width="200" padding="5" background="#1f242c" border-width="1" border-color="#30363d" radius="8">
  <control id="end" value="⚠  Terminate (SIGTERM)…" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#ff7b72" background="#1f242c" border-width="0" radius="5" />
  <view height="9" padding="4,0,4,0">
    <view height="1" background="#30363d" />
  </view>
  <view height="30">
    <control id="copy" value="📋  Copy                         ▸" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
    <column id="copy-menu" position="absolute" left="100%" top="-4" width="150" height="0" visible="false" clip="true" padding="5" background="#1f242c" border-width="1" border-color="#30363d" radius="8">
      <control id="name" value="Copy Name" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
      <control id="pid" value="Copy PID" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
      <control id="command" value="Copy Command Line" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
      <control id="details" value="Copy Full Row" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
    </column>
  </view>
  <control id="filter" value="⌕  Filter by this Process" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
  <view height="9" padding="4,0,4,0">
    <view height="1" background="#30363d" />
  </view>
  <control id="refresh" value="⟳  Refresh Now" height="30" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" text-align="left" color="#f0f6fc" background="#1f242c" border-width="0" radius="5" />
</column>
