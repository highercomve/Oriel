<column position="absolute" top="0" left="0" width="100%" height="100%" justify="center" align="center" background="#000000a6"><column width="440" padding="20" gap="12" background="#161b22" border-width="1" border-color="#30363d" radius="10"><row align="center" gap="10"><text font-size="20" color="#d29922">⚠</text><text font-size="16" font-weight="600">Send SIGTERM?</text></row><text id="description" font-size="13" line-height="19.5">Confirmation</text><text font-size="11" color="#8b949e" line-height="15.4">SIGTERM is a polite request to exit. Unsaved work may be lost. The process may handle or ignore the signal.</text><row gap="8" justify="flex-end"><control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="cancel" value="Cancel" height="28" width="76" font-size="12" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" radius="6" /><control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="confirm" value="Send SIGTERM" height="28" width="122" font-size="12" background="#da3633" color="#ffffff" border-width="1" border-color="#30363d" radius="6" /></row></column></column>