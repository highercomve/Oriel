<column gap="3">
  <row gap="8">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" shrink="0" id="name" grow="1" shrink="1" min-width="0" nowrap="true" font-weight="600" line-height="18.0">{name}</text>
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#8b949e" shrink="0" id="size" mono="true" line-height="18.0">{size}</text>
  </row>
  <canvas id="bar" height="6" />
  <row gap="8">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="mount" grow="1" shrink="1" min-width="0" nowrap="true" line-height="16.5">{mount}</text>
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#6e7681" shrink="0" id="rw" mono="true" line-height="16.5">{rw}</text>
  </row>
</column>
