<column id="settings-panel" scroll="true" clip="true" position="absolute" top="52" right="16" width="260" padding="12" gap="8" background="#1f242c" border-width="1" border-color="#30363d" radius="8">
  <text font-size="11" color="#8b949e" font-weight="700" letter-spacing="0.5" nowrap="true" shrink="0">SHOW</text>
  <column gap="2">
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Summary tiles</text>
      <canvas id="tiles-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="tiles" value="" label="Summary tiles" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">System</text>
      <canvas id="system-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="system" value="" label="System" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">CPU details</text>
      <canvas id="cpu-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="cpu" value="" label="CPU details" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Memory</text>
      <canvas id="mem-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="mem" value="" label="Memory" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Disks</text>
      <canvas id="disks-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="disks" value="" label="Disks" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Network</text>
      <canvas id="net-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="net" value="" label="Network" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Sensors</text>
      <canvas id="sensors-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sensors" value="" label="Sensors" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
    <row height="28" align="center" padding="5,6,5,6">
      <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="12" color="#f0f6fc" grow="1">Processes</text>
      <canvas id="proc-switch" width="30" height="16" />
      <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="proc" value="" label="Processes" position="absolute" top="0" left="0" width="100%" height="100%" background="#00000000" border-width="0" radius="5" />
    </row>
  </column>
  <text font-size="11" color="#8b949e" font-weight="700" letter-spacing="0.5" nowrap="true" shrink="0">SAMPLE EVERY</text>
  <row gap="2" padding="2" background="#0e1117" border-width="1" border-color="#30363d" radius="6" align-self="flex-start">
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="interval-1" value="1 s" width="36" height="22" font-size="11" color="#8b949e" background="#00000000" border-width="0" radius="4" />
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="interval-2" value="2 s" width="36" height="22" font-size="11" color="#8b949e" background="#00000000" border-width="0" radius="4" />
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="interval-5" value="5 s" width="36" height="22" font-size="11" color="#8b949e" background="#00000000" border-width="0" radius="4" />
  </row>
  <text font-size="11" color="#6e7681" shrink="0" line-height="16">Hidden parts cost nothing: they aren’t drawn or updated.</text>
</column>
