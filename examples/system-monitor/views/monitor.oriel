<column id="root" height="100%" background="#0e1117">
  <row height="48" padding="10,16,10,16" align="center" gap="10" background="#161b22" border-bottom="1" border-color="#30363d">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="18" color="#d29922" shrink="0" line-height="27.0">⚡</text>
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="14" color="#f0f6fc" shrink="0" font-weight="600" line-height="21.0">Oriel System Monitor</text>
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#39c5bb" shrink="0" background="#183334" padding="2,7,2,7" radius="12" line-height="16.5">oriel</text>
    <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#3fb950" shrink="0" id="perf" mono="true" background="#163022" padding="2,7,2,7" radius="12" line-height="16.5">-- ms</text>
    <view grow="1" />
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#3fb950" shrink="0" line-height="16.5">●</text>
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" id="status" line-height="16.5">Initializing telemetry…</text>
    <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="settings" value="⚙ Settings" width="84" height="28" font-size="12" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" radius="6" />
  </row>
  <column id="body" scroll="true" grow="1" shrink="1" min-height="0" padding="16" gap="14">
    <row id="tiles" wrap="wrap" gap="12">
      <button id="cpu-tile" min-height="120" padding="12,14,12,14" gap="4" background="#161b22" border-width="1" border-color="#30363d" radius="8">
        <row align="center" gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">CPU ▾</text>
          <view grow="1" />
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" id="cpu-tile-detail" shrink="1" min-width="0" nowrap="true" line-height="16.5">--</text>
        </row>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="24" color="#f0f6fc" shrink="0" id="cpu-value" font-weight="700" mono="true" line-height="36.0">0</text>
        <view grow="1" />
        <canvas id="cpu-spark" height="34" />
      </button>
      <column id="mem-tile" min-height="120" padding="12,14,12,14" gap="4" background="#161b22" border-width="1" border-color="#30363d" radius="8">
        <row align="center" gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">MEMORY</text>
          <view grow="1" />
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" id="mem-tile-detail" shrink="1" min-width="0" nowrap="true" line-height="16.5">--</text>
        </row>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="24" color="#f0f6fc" shrink="0" id="mem-value" font-weight="700" mono="true" line-height="36.0">0</text>
        <view grow="1" />
        <canvas id="mem-spark" height="34" />
      </column>
      <column id="proc-tile" min-height="120" padding="12,14,12,14" gap="4" background="#161b22" border-width="1" border-color="#30363d" radius="8">
        <row align="center" gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">PROCESSES</text>
          <view grow="1" />
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" id="thread-value" shrink="1" min-width="0" nowrap="true" line-height="16.5">--</text>
        </row>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="24" color="#f0f6fc" shrink="0" id="proc-value" font-weight="700" mono="true" line-height="36.0">0</text>
        <view grow="1" />
        <canvas id="proc-spark" height="34" />
      </column>
      <column id="uptime-tile" min-height="120" padding="12,14,12,14" gap="4" background="#161b22" border-width="1" border-color="#30363d" radius="8">
        <row align="center" gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">UPTIME</text>
          <view grow="1" />
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" id="boot-detail" shrink="1" min-width="0" nowrap="true" line-height="16.5">since boot</text>
        </row>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="24" color="#f0f6fc" shrink="0" id="uptime" font-weight="700" mono="true" line-height="36.0">0</text>
        <view grow="1" />
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="cadence" line-height="16.5">60 samples kept · 2 s cadence</text>
      </column>
    </row>
    <column id="system" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
      <row gap="8">
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">SYSTEM</text>
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="sys-host" line-height="16.5">--</text>
      </row>
      <canvas id="system-info" height="42" />
    </column>
    <column id="cpu" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
      <row align="center" gap="8">
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">CPU</text>
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" id="cpu-detail" grow="1" shrink="1" min-width="0" nowrap="true" line-height="16.5">--</text>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#8b949e" shrink="0" id="cpu-freq" mono="true" background="#0e1117" border-width="1" border-color="#30363d" radius="10" padding="1,8,1,8" line-height="16.5">--</text>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#8b949e" shrink="0" id="cpu-temp" mono="true" background="#0e1117" border-width="1" border-color="#30363d" radius="10" padding="1,8,1,8" line-height="16.5">--</text>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#8b949e" shrink="0" id="cpu-load" mono="true" background="#0e1117" border-width="1" border-color="#30363d" radius="10" padding="1,8,1,8" line-height="16.5">--</text>
        <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="11" color="#8b949e" shrink="0" id="cpu-tasks" mono="true" background="#0e1117" border-width="1" border-color="#30363d" radius="10" padding="1,8,1,8" line-height="16.5">--</text>
      </row>
      <row id="cpu-body" gap="12">
        <column id="cpu-graph" basis="0" grow="1" gap="8" min-width="0">
          <canvas id="cpu-chart" height="96" background="#0e1117" border-width="1" border-color="#30363d" radius="6" />
          <canvas id="cpu-legend" height="17" />
        </column>
        <canvas id="core-chart" basis="0" grow="1" height="96" min-width="0" />
      </row>
    </column>
    <row id="panels-row" wrap="wrap" gap="12" align="stretch">
      <column id="mem" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
        <row gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">MEMORY</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="mem-detail" line-height="16.5">--</text>
        </row>
        <canvas id="mem-chart" height="168" />
      </column>
      <column id="disks" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
        <row gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">DISKS</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="disk-io" line-height="16.5">R -- · W --</text>
        </row>
        <column id="disk-list" gap="8" />
      </column>
      <column id="net" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
        <row align="center" gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">NETWORK</text>
          <view grow="1" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="net-prev" value="‹" width="20" font-size="12" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" radius="6" height="20" />
          <text font-family="ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace" font-size="12" color="#f0f6fc" shrink="0" id="net-iface" mono="true" line-height="18.0">--</text>
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="net-next" value="›" width="20" font-size="12" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" radius="6" height="20" />
        </row>
        <canvas id="net-chart" height="96" background="#0e1117" border-width="1" border-color="#30363d" radius="6" />
        <canvas id="net-detail" height="76" />
      </column>
      <column id="sensors" padding="12,14,12,14" gap="10" border-width="1" border-color="#30363d" background="#161b22" radius="8" min-width="0">
        <row gap="8">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="700" letter-spacing="0.5" nowrap="true" line-height="16.5">SENSORS</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="sensor-count" line-height="16.5">--</text>
        </row>
        <view id="sensor-scroll" scroll="true" height="228" clip="true">
          <canvas id="sensor-detail" height="228" />
        </view>
      </column>
    </row>
    <column id="proc" gap="14" min-height="460" grow="1">
      <row id="toolbar" align="center" gap="8" padding="8,12,8,12" background="#161b22" border-width="1" border-color="#30363d" radius="8">
        <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="pause" value="⏸ Pause" width="76" height="28" font-size="12" font-weight="500" color="#f0f6fc" background="#21262d" border-width="1" border-color="#30363d" radius="6" />
        <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="refresh" value="⟳ Refresh" width="82" height="28" font-size="12" font-weight="500" color="#8b949e" background="#161b22" border-width="1" border-color="#30363d" radius="6" />
        <row id="search-box" width="260" height="28" align="center" gap="4" padding="0,4,0,8" background="#0e1117" border-width="1" border-color="#30363d" radius="6">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" line-height="16.5">🔍</text>
          <input id="search" grow="1" basis="0" min-width="0" height="26" font-size="12" color="#f0f6fc" background="#0e1117" border-width="0" padding="0,4,0,4" placeholder="Filter by name, user, command or pid…" label="Filter processes" value="" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="clear" value="×" tooltip="Clear filter" label="Clear filter" width="20" height="20" font-size="14" color="#8b949e" background="#0e1117" border-width="0" radius="4" visible="false" />
        </row>
        <view grow="1" />
        <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" line-height="16.5">Sort:</text>
        <row gap="2" padding="2" background="#0e1117" border-width="1" border-color="#30363d" radius="6">
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-cpu" value="CPU" width="40" font-weight="500" color="#8b949e" background="#0e1117" border-width="0" radius="4" height="22" font-size="11" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-mem" value="Memory" width="62" font-weight="500" color="#8b949e" background="#0e1117" border-width="0" radius="4" height="22" font-size="11" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-threads" value="Threads" width="63" font-weight="500" color="#8b949e" background="#0e1117" border-width="0" radius="4" height="22" font-size="11" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-pid" value="PID" width="36" font-weight="500" color="#8b949e" background="#0e1117" border-width="0" radius="4" height="22" font-size="11" />
          <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-name" value="Name" width="48" font-weight="500" color="#8b949e" background="#0e1117" border-width="0" radius="4" height="22" font-size="11" />
        </row>
        <control font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" id="sort-dir" value="▼" width="28" height="28" font-size="10" color="#f0f6fc" background="#0e1117" border-width="1" border-color="#30363d" radius="6" />
      </row>
      <column id="table" grow="1" min-height="0" background="#161b22" border-width="1" border-color="#30363d" radius="8" clip="true">
        <row align="center" gap="8" padding="10,14,10,14" border-bottom="1" border-color="#30363d">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="13" color="#f0f6fc" shrink="0" font-weight="600" line-height="19.5">Processes</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" id="proc-detail" background="#21262d" radius="12" padding="2,7,2,7" line-height="16.5">0 of 0</text>
          <view grow="1" />
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" line-height="16.5">Right-click or click Terminate for polite SIGTERM (confirmed first)</text>
        </row>
        <row height="32" align="center" padding="0,16,0,16" background="#1f242c" border-bottom="1" border-color="#30363d">
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="90" line-height="16.5">PID</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="190" line-height="16.5">Name</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="90" line-height="16.5">User</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="50" line-height="16.5">State</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="48" line-height="16.5">Thr</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="90" line-height="16.5">CPU %</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="110" line-height="16.5">Memory</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" basis="0" grow="1" min-width="0" line-height="16.5">Command line</text>
          <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#8b949e" shrink="0" font-weight="600" width="140" line-height="16.5">Actions</text>
        </row>
        <column id="proc-scroll" scroll="true" clip="true" grow="1" basis="0" min-height="0">
          <view id="before" height="0" />
          <column id="rows" />
          <view id="after" height="0" />
        </column>
      </column>
    </column>
  </column>
  <row id="footer" height="24" align="center" padding="4,16,4,16" background="#161b22" border-bottom="1" border-color="#30363d">
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" id="footer-status" line-height="16.5">Ready</text>
    <view grow="1" />
    <text font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="11" color="#6e7681" shrink="0" line-height="16.5">Oriel</text>
  </row>
</column>
