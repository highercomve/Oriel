     is yours to edit. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- oriel:permissions begin -->
    <!-- oriel:permissions end -->
    <!-- oriel:features begin -->
    <!-- oriel:features end -->
    <!-- oriel:queries begin -->
    <!-- oriel.dictation's system engine: Android 11+ only lets apps see the
         speech recognition services they declare. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- oriel:queries end -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Oriel"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true">

        <!-- GPU/NPU drivers ggml may use (src/modules/ggml_gpu.zig): optional,
             Android 12+ only lets apps open vendor libraries they declare. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name="dev.oriel.OrielMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="720dp"
                android:minWidth="360dp"
                android:minHeight="320dp" />
            <!-- oriel:main-activity begin -->
            <!-- oriel:main-activity end -->
        </activity>

        <!-- The launcher icon: opens the main window at its remembered size
             (OrielLaunchActivity), then goes. No task affinity: its own
             throwaway task, so the main window gets a task of its own (with
             the launch bounds) rather than this one. -->
        <activity
            android:name="dev.oriel.OrielLaunchActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.oriel.OrielWindowActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale" />

        <activity
            android:name="dev.oriel.OrielTransparentWindowActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Oriel.Transparent"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale" />

        <!-- oriel:components begin -->
        <!-- oriel:components end -->

        <receiver
            android:name="dev.oriel.OrielActionReceiver"
            android:exported="false" />

        <provider
            android:name="dev.oriel.OrielFileProvider"
            android:authorities="${applicationId}.oriel.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
