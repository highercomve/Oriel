<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by `oriel android init` from build.zig (rewritten by `oriel android init` with the force flag). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- oriel.dictation's system engine: Android 11+ only lets apps see the
         speech recognition services they declare. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Oriel"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true">

        <!-- GPU/NPU drivers ggml may use (src/modules/ggml_gpu.zig): optional,
             Android 12+ only lets apps open vendor libraries they declare. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name="dev.oriel.OrielMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="720dp"
                android:minWidth="360dp"
                android:minHeight="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oriel-showcase" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.oriel.OrielWindowActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale" />

        <service
            android:name="dev.oriel.OrielAudioService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name="dev.oriel.OrielActionReceiver"
            android:exported="false" />

        <service
            android:name="dev.oriel.OrielTileService"
            android:exported="true"
            android:label="Dictate anywhere"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="dev.oriel.OrielInputMethod"
            android:exported="true"
            android:label="Oriel dictation"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/oriel_input_method" />
        </service>

        <provider
            android:name="dev.oriel.OrielFileProvider"
            android:authorities="${applicationId}.oriel.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
